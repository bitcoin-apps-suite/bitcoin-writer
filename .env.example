# --- HandCash Connect (server-side) ---
# In the HandCash developer dashboard: enable PAY, USER_PUBLIC_PROFILE and DECRYPTION permissions,
# and set the redirect URL to https://<your-domain>/api/auth/handcash/callback
HANDCASH_APP_ID=your-handcash-app-id
HANDCASH_APP_SECRET=your-handcash-app-secret

# Encrypts the session cookie. Any long random string (openssl rand -hex 32).
SESSION_SECRET=your-random-session-secret

# --- Saving to chain (UTXO-CHAIN-SPEC.md) ---
# HandCash handle or paymail that receives the service fee (2x miner fee model, as BSVStorageService).
# The miner fee itself is paid by the user to their own derived funding address — no server wallet key.
PUBLISH_HANDCASH_DESTINATION=your-business-handle

# Optional: WhatsOnChain API key (raises rate limits for reading/broadcasting chain transactions)
WHATSONCHAIN_API_KEY=

# --- Supabase (shared with b0ase.com) — chain index (bwriter_commits) + $bWriter staking ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Desktop download link shown on the landing page
NEXT_PUBLIC_DESKTOP_DOWNLOAD_URL=https://github.com/bitcoin-apps-suite/bitcoin-writer/releases/latest
