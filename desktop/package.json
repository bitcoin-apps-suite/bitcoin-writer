{
  "name": "bitcoin-writer-desktop",
  "productName": "Bitcoin Writer",
  "version": "1.0.0",
  "description": "Bitcoin Writer desktop app: encrypted, git-style commits to Bitcoin SV",
  "author": "The Bitcoin Corporation LTD",
  "license": "SEE LICENSE IN ../LICENSE",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "BW_APP_URL=http://localhost:3000 electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "release": "electron-builder --mac --win --linux --publish always"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.bitcoinwriter.desktop",
    "productName": "Bitcoin Writer",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "bitcoin-apps-suite",
        "repo": "bitcoin-writer"
      }
    ]
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller"
    ]
  }
}
